# Post Quantum Vpn Wireguard Agent — Environment Configuration
# Copy this file to .env and configure your values.

# HMAC-SHA256 Audit Trail Secret Key (required for production)
# Generate a secure key: python -c "import os; print(os.urandom(32).hex())"
AUDIT_SECRET_KEY=

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock

# Server Configuration
HOST=127.0.0.1
PORT=8000
