# Optional HMAC-SHA256 audit key for a single service process.
# Generate: python -c "import os; print(os.urandom(32).hex())"
# Without this key, the in-memory audit trail gets a new key at startup.
AUDIT_SECRET_KEY=

# The current implementation only provides deterministic mock responses.
MODEL_PROVIDER=mock

# Bind to loopback unless you provide an authenticated reverse proxy.
HOST=127.0.0.1
PORT=8000
