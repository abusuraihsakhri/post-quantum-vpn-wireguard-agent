{
  "openapi": "3.1.0",
  "info": {
    "title": "Post-Quantum VPN / WireGuard Concept Evaluator API",
    "version": "2.1.0",
    "description": "Deterministic rules and in-memory HMAC audit metadata; not a WireGuard tunnel or post-quantum cryptographic implementation. GET /openapi.json on a running server provides the authoritative generated schema."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Local service health",
        "responses": {
          "200": {
            "description": "JSON status"
          }
        }
      }
    },
    "/metrics": {
      "get": {
        "summary": "In-memory counters as JSON",
        "responses": {
          "200": {
            "description": "JSON counters"
          }
        }
      }
    },
    "/api/audit": {
      "post": {
        "summary": "Evaluate illustrative thresholds and descriptor flags",
        "responses": {
          "200": {
            "description": "Rule evaluation dossier"
          },
          "422": {
            "description": "Invalid input or blocked identifier"
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "summary": "Return a deterministic mock response",
        "responses": {
          "200": {
            "description": "Mock response"
          },
          "422": {
            "description": "Blocked identifier"
          }
        }
      }
    },
    "/api/audit/logs": {
      "get": {
        "summary": "Read in-memory HMAC hash-chain metadata",
        "responses": {
          "200": {
            "description": "Audit ledger snapshot and verification status"
          }
        }
      }
    }
  }
}
